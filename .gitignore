# Python environment
.venv/
__pycache__/
*.py[cod]

# macOS
.DS_Store

# 每一次 run 的成果。可以由 produce.py 重做，也可能很大
projects/

# 拿進來的原片。sidecar（corrections / extra_segments / terms）刻意留在版控裡
work/*.mp4
work/*.webm
work/*.m4a
work/*.info.json
work/.*.speech.json

# 素材：去背圖是從 images/ 產的，影片是下載的，都可以重做
assets/cutouts/
assets/clips/

# 衍生檔：proxy、波形、縮圖、字幕圖、抽出來的音軌、Chrome 的 profile
editor_cache/

# 刪掉但還沒真的丟的東西
trash/

# 執行紀錄
*.log
