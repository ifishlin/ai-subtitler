# Python environment
.venv/
__pycache__/
*.py[cod]

# macOS
.DS_Store

# 每一次 run 的成果。可以由 produce.py 重做，也可能很大
projects/

# 拿進來的原片。sidecar（corrections / extra_segments / terms）刻意留在版控裡
work/*.mp4
work/*.webm
work/*.m4a
work/*.info.json
work/.*.speech.json

# 素材：去背圖是從 images/ 產的，影片是下載的，都可以重做
assets/cutouts/
# 抓回來的照片和新聞影片，隨時可以重抓
# （gitignore 沒有行尾註解：# 只有在行首才是註解，寫在後面會變成路徑的一部分）
assets/photos/
assets/footage/
assets/clips/
# 抓回來的報導正文。是別人寫的文章，而且隨時可以重抓 —— 存在磁碟上是為了
# 重跑不用重抓、以及你打得開來看，不是為了留在版控裡。
assets/articles/
# 情境影片：影片檔不進版控（一百支一 GB），但 library.json 要進 ——
# 那份是「哪幾支看過、留下了哪幾支」，是判斷不是素材，重抓一次補不回來。
assets/broll/*.mp4
# 上一次組 prompt 抽到哪幾支。它跟著那一份文案有意義，重抽就換一批，
# 不是判斷也不是素材 —— 但**不能刪**：刪了之後 V2 在 prompt 和 fasten
# 兩邊會指著不同的影片。它進不進版控無所謂，留在磁碟上才要緊。
assets/broll/offered/
# 剪出來的影片段落。JSON 要進版控（起訖是算出來的判斷，而且文案的 C 編號
# 指著它），mp4 不進 —— 四十段 720p 五十幾 MB，而且照那份 JSON 隨時可以
# 重剪。檔名帶起訖的指紋，改了切法就換名字。
assets/passages/*/
# 片型是設計出來的，跟程式一起走

# 衍生檔：proxy、波形、縮圖、字幕圖、抽出來的音軌、Chrome 的 profile
editor_cache/

# 刪掉但還沒真的丟的東西
trash/

# 題目和文案是寫出來的，跟程式一起走 —— topics/ 和 scripts/ 不忽略

# 執行紀錄
*.log

# 隨手產出的短影音
SHORT_*.mp4

# 壓出來的成品和它的半成品。整支片可以從 scripts/*.json 重做，而中間的 36 個
# 鏡頭更是純粹的暫存 —— 一次 `git add -A` 把它們全掃進去了，74 個檔 59 MB。
assets/shorts/

# 卡片管理頁的示範圖。檔名帶畫法名和程式指紋，改了程式就重畫。
assets/cards/demo/

# 畫出來的卡片。規格在 scripts/*.json 裡，檔名是那份規格的雜湊，
# 隨時可以重畫。templates/ 是手寫的，留著。
assets/cards/*/
!assets/cards/templates/

# 本機設定：選哪個模型、通道開在哪。可能會被塞進金鑰，所以不進版控。
# config.example.toml 才是版控裡的那份，它只寫金鑰「在哪個檔案」。
config.toml
